# Optional overrides for the local stack (docker-compose.yml).
# Every value below already has a default in the compose file; copy to .env
# only to change one or to plug in external API keys.

# --- Storage credentials ------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
CLICKHOUSE_USER=dev
CLICKHOUSE_PASSWORD=dev_password
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_password
S3_BUCKET=kstock-bucket-dev
KAFKA_TOPIC=raw_data_trade

# --- Host ports ---------------------------------------------------------------
GATEWAY_PORT=80
FRONTEND_PORT=5173
AUTH_PORT=8000
CORE_API_PORT=8080
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379
KAFKA_HOST_PORT=29092
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
QDRANT_PORT=6333
AIRFLOW_PORT=8089

# --- auth-service -------------------------------------------------------------
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
GOOGLE_CLIENT_ID=

# --- External APIs (only for the optional profiles) ---------------------------
# profile market-feed: live tick source
MARKET_STATUS_URL=
WS_URL1=
WS_URL2=
WS_URL3=
WS_URL4=
# profile news / airflow: comma-separated Finnhub API keys
FINNHUB_API_KEYS=
# profile news: embeddings for news-processing
OPENAI_API_KEY=

# --- Airflow (profile airflow) ------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=local-airflow-jwt-secret
